# Required
ENVIRONMENT=gorest
BASE_URL=https://gorest.co.in/public/v2
GOREST_TOKEN=your_token_here
LOG_LEVEL=INFO

# TestIT (optional)
TESTIT_URL=https://your-testit.example.com/projects/1/tests/{testit_id}

# Database (optional — only when data unavailable via API)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=testuser
DB_PASSWORD=testpassword
DB_SSH_HOST=
DB_SSH_PORT=22
DB_SSH_USER=
DB_SSH_KEY_FILE=~/.ssh/id_rsa
